    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Safety gate: allow only the three exact fictional records in our test sheet.\n// No personal applicant data is passed downstream. At most 3 items, one per demo candidate.\nconst allowed = {\n  'Demo Candidate A': { email: 'candidate-a@example.com', role: 'Office Assistant', experience: '6+ Years' },\n  'Demo Candidate B': { email: 'candidate-b@example.com', role: 'Support Specialist', experience: '3-5 Years' },\n  'Demo Candidate C': { email: 'candidate-c@example.com', role: 'Operations Assistant', experience: '0-2 Years' },\n};\nconst seen = new Set();\nconst safe = [];\nfor (const [index, item] of $input.all().entries()) {\n  const candidate = String(item.json['Full Name'] ?? '').trim();\n  const row = allowed[candidate];\n  if (!row || seen.has(candidate)) continue;\n  if (String(item.json['Email Address'] ?? '').trim().toLowerCase() !== row.email) continue;\n  if (String(item.json['Position applying for'] ?? '').trim() !== row.role) continue;\n  if (String(item.json['Years of experience'] ?? '').trim() !== row.experience) continue;\n  seen.add(candidate);\n  safe.push({\n    json: {\n      'Full Name': candidate,\n      'Email Address': row.email,\n      'Position applying for': row.role,\n      'Years of experience': row.experience,\n      'test_notice': 'Fictional data only - not a real recruitment decision',\n    },\n    pairedItem: { item: index },\n  });\n  if (safe.length === 3) break;\n}\nreturn safe;\n"
      },
      "id": "a0d61b31-1a00-4fd5-8c6c-6e58f4947b1b",
      "name": "Safety Gate - Demo Candidates Only",
